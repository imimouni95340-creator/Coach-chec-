# Path to the Stockfish binary. Autodetected via PATH if unset
# (falls back to /usr/games/stockfish, the default apt install location).
COACH_STOCKFISH_PATH=/usr/games/stockfish

# SQLite by default. Swap for Postgres later, e.g.:
# COACH_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chess_coach
COACH_DATABASE_URL=sqlite:///./chess_coach.db
